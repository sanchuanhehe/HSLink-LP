  (title_block 
    (title "HSLink-LP 整体电路审阅稿") 
    (date "2026-11-04") 
    (rev "0.1-DRAFT") 
    (company "HSLink-LP") 
    (comment 1 "信号 1.8–3.3 V；未经硬件验证；禁止直接投板")) 
  (text "HSLink-LP / Rev 0.1\nUSB 供电控制器 + 双 CDC + SWD/JTAG\n\n手动选择内置／外部电源，电脑控制目标供电开关。\nMEASURE：保持目标供电，所有信号、采样、Vref、放电断开。\n\n信号：1.8–3.3 V；内置：1.8–5 V；外部：1.8–5.5 V。\n本稿用于电气连接与选型审阅，尚未完成 PCB 和样机验证。" 
    (at 20 32 0) 
    (effects 
      (font 
        (size 1.5 1.5)) 
      (justify left top)) 
    (uuid "c5c03dc0-e116-57c4-9143-328f92d99684")) 
